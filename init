#!/bin/bash
# Set up this machine for the current user:
#   init                system (once per machine) and user; then log out and
#                       back in, and the next shell offers init user-login
#   init system [name...]     rerun the machine-wide scripts, or only the named ones (needs sudo)
#   init user [name...]       rerun the per-user scripts, or only the named ones
#   init user-login [name...] gh login and ssh key upload (needs the login keyring)
#   init apps [name...]       optional apps, e.g. init apps margin; no name lists them
set -euo pipefail
cd "$(dirname "$(realpath "$0")")"

# Written by run-all when the system phase finished without failures
system_done=/var/lib/newdotfiles/system-done

case ${1:-} in
	"")
		[[ -f $system_done ]] || ./setup/run-all system || exit 1
		exec ./setup/run-all user
		;;
	system | user | user-login)
		exec ./setup/run-all "$@"
		;;
	apps)
		shift
		if (($# == 0)); then
			echo "Apps: $(ls setup/apps | tr '\n' ' ')"
			exit 0
		fi
		exec ./setup/run-all apps "$@"
		;;
	*)
		sed -n '2,8s/^# //p' "$0"
		exit 1
		;;
esac
