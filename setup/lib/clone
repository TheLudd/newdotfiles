#!/bin/bash
# Usage: lib/clone <dir> <url> [origin-url]
# Clones url into dir unless it is already there, then points origin at
# origin-url when given: repos are cloned over https before an ssh key
# exists, and pushed to over ssh.
set -euo pipefail
dir=$1
url=$2
origin=${3:-}

[[ -d $dir/.git ]] || git clone "$url" "$dir"
[[ -z $origin ]] || git -C "$dir" remote set-url origin "$origin"
