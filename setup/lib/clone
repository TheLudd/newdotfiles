#!/bin/bash
# Usage: lib/clone <dir> <url> [push-url]
# Clones url into dir unless it is already there. origin fetches from url and
# pushes to push-url when given: repos are cloned and fetched over https, which
# needs no key, and pushed to over ssh once the key is on GitHub.
set -euo pipefail
dir=$1
url=$2
push=${3:-}

[[ -d $dir/.git ]] || git clone "$url" "$dir"
git -C "$dir" remote set-url origin "$url"
[[ -z $push ]] || git -C "$dir" remote set-url --push origin "$push"
