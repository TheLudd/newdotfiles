#!/bin/bash
# Clone each repo in `repos` into ~/code/<name> and install it system-wide.
# Builds as the user and installs as root, so install targets must not
# rebuild. Makefiles without an `all` target (sx) only install.
set -uo pipefail

has_all_target() { make -C "$1" -n all >/dev/null 2>&1; }

install_repo() {
	local dir=$1
	lib/clone "$@" &&
		{ ! has_all_target "$dir" || make -C "$dir" all; } &&
		sudo make -C "$dir" install
}

status=0
while read -r name url origin; do
	[[ -z $name || $name == \#* ]] && continue
	echo "-- $name"
	install_repo "$HOME/code/$name" "$url" ${origin:+"$origin"} || {
		echo "$name failed"
		status=1
	}
done < repos
exit $status
