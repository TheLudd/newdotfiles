#!/bin/bash
# Clone each repo in `repos` into ~/code/<name> and install it system-wide.
# Builds as the user and installs as root, so install targets must not
# rebuild. Makefiles without an `all` target (sx) only install.
set -uo pipefail

has_all_target() { make -C "$1" -n all >/dev/null 2>&1; }

install_repo() {
	local dir=$1
	lib/clone "$@" &&
		{ ! has_all_target "$dir" || make -C "$dir" all; } &&
		sudo make -C "$dir" install
}

# dwm and dwmblocks are installed per user (user/50-sources); an old
# system-wide copy would run for a user who has not installed their own
remove_system_copies() {
	sudo rm -f /usr/local/bin/dwm /usr/local/bin/dwmblocks /usr/local/share/man/man1/dwm.1
}

status=0
while read -r name url push; do
	[[ -z $name || $name == \#* ]] && continue
	echo "-- $name"
	install_repo "$HOME/code/$name" "$url" ${push:+"$push"} || {
		echo "$name failed"
		status=1
	}
done < repos
remove_system_copies || status=1
exit $status
