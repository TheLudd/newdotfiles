#!/bin/zsh
# Serve margin at http://margin.local through nginx. The site config and the
# settings for the whole http block (http.conf) are copied into nginx's
# sites-enabled, which Arch's stock nginx.conf neither creates nor includes.
# Copies, so nginx does not depend on a user's home; after an edit here this
# script is run again.
sudo mkdir -p /etc/nginx/sites-enabled
if ! grep -q 'include /etc/nginx/sites-enabled/\*;' /etc/nginx/nginx.conf; then
	sudo sed -i 's|^http {$|http {\n    include /etc/nginx/sites-enabled/*;|' /etc/nginx/nginx.conf
fi
for site in http.conf margin.conf; do
	sudo install -m 644 "files/nginx/$site" "/etc/nginx/sites-enabled/$site"
done
sudo nginx -t && sudo systemctl enable --now nginx && sudo systemctl reload nginx
