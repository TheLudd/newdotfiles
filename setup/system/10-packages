#!/bin/bash
# Install the packages in `packages`, those of this machine's units, its kernel
# and the ones its hardware needs (lib/wanted-packages), upgrading the system in the same run so nothing is
# installed against an outdated package database. Microcode needs no GRUB step:
# the mkinitcpio `microcode` hook packs it into the initramfs, which pacman
# rebuilds when firmware is installed.
set -euo pipefail
lib/wanted-packages repo | sudo pacman -Syu --needed --noconfirm -
