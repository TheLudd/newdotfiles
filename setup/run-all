#!/bin/bash
# Usage: run-all <folder> [name...]
# Runs every script in folder in name order, or only the named ones. A failing
# script does not stop the others: a script that depends on an earlier one
# checks for what it needs itself. Failures are listed at the end and make the
# exit status non-zero, so after a fix the phase is simply run again.
#
# Exports the XDG paths (lib/zshenv) and the tool homes such as CARGO_HOME
# (config/zsh/exports.zsh) first: on a fresh machine they are not in the
# environment until zsh is set up and you log in again.
#
# Scripts run with setup/ as the working directory, so they reach lib/, the
# package lists and files/ by relative path, and the rest of the repo (config/,
# bin/, autorandr/...) through $DOTFILES.
set -uo pipefail
cd "$(dirname "$(realpath "$0")")"

folder=${1:?Usage: run-all <folder> [name...]}
shift
[[ -d $folder ]] || { echo "No folder $folder" >&2; exit 1; }

set -a
DOTFILES=$(dirname "$PWD")
source lib/zshenv
source "$DOTFILES/config/zsh/exports.zsh"
set +a
PATH="$DOTFILES/bin:$PATH"

scripts=()
if (($#)); then
	for name in "$@"; do
		if [[ ! -f $folder/$name ]]; then
			echo "Unknown in $folder: $name. Valid: $(ls "$folder" | tr '\n' ' ')" >&2
			exit 1
		fi
		scripts+=("$folder/$name")
	done
else
	scripts=("$folder"/*)
fi

failed=()
for script in "${scripts[@]}"; do
	echo "==> $script"
	"./$script" || failed+=("$script")
done

echo
if ((${#failed[@]})); then
	echo "Failed in $folder:"
	printf '  %s\n' "${failed[@]}"
	exit 1
fi
# init skips the system phase once this exists
[[ $folder == system && $# == 0 ]] && sudo install -D -m 644 /dev/null /var/lib/newdotfiles/system-done
echo "Done: $folder"
