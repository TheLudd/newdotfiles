#!/bin/bash
# Install pnpm (lib/install-pnpm), n through
# pnpm and node LTS through n, all in the user's home: PNPM_HOME and N_PREFIX
# come from config/zsh/exports.zsh. Node versions are switched with `n <version>`.
set -euo pipefail
# pnpm refuses global installs while its bin directory is not on PATH
export PATH="$PNPM_HOME/bin:$N_PREFIX/bin:$PATH"

lib/install-pnpm
[ -x "$PNPM_HOME/bin/n" ] || pnpm add -g n
[ -x "$N_PREFIX/bin/node" ] || n lts
