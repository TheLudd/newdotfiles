#!/bin/bash
# Usage: add-user <username>
# Create a user in wheel with zsh as shell and ask for its password. Every
# wheel member has sudo without a password (/etc/sudoers.d/wheel). Run as
# root: install-encrypted runs it in the new system, later use sudo.
set -euo pipefail
[ "$#" -eq 1 ] || { echo "Usage: $0 <username>"; exit 1; }
user=$1
home="/home/$user"

pacman -Q sudo &>/dev/null || pacman -S --noconfirm sudo

if id "$user" &>/dev/null; then
	echo "User $user exists"
elif [ -d "$home" ]; then
	# A kept /home partition already holds this user's files
	useradd -d "$home" -M -s /bin/zsh -G wheel "$user"
else
	useradd -m -s /bin/zsh -G wheel "$user"
fi

until passwd "$user"; do :; done

echo '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel
visudo -cf /etc/sudoers.d/wheel
