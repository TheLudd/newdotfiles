#!/bin/sh
# Output Claude plan usage for dwmblocks: session, weekly and model-scoped weekly limits.
# Reads the OAuth token Claude Code stores and asks the usage endpoint; no model call, no tokens.
# Prints nothing when the token is missing, expired or the request fails.

credentials="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
[ -r "$credentials" ] || exit 0

token=$(jq -r '.claudeAiOauth.accessToken // empty' "$credentials")
[ -n "$token" ] || exit 0

curl -sf --max-time 5 https://api.anthropic.com/api/oauth/usage \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" |
jq -r '
    def short:
        if .kind == "session" then "S"
        elif .kind == "weekly_all" then "W"
        else (.scope.model.display_name // .kind)[0:1]
        end;
    [.limits[] | "\(short) \(.percent)%"] | "🤖 " + join(" ")
'
