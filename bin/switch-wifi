#!/bin/bash
if [ -n "$1" ]
then
	selection=$1
else
	selection=`nmcli c | sed '/wlan0/d' | tail -n +2 | awk '{print $1}' | sort | dmenu  -i -l 100`
fi

if	[ -n "$selection" ]
then
	ssid=`nmcli c show $selection | grep -F '.ssid:' | sed 's/^.*:\s\+//'`
	pwd=`nmcli c show $selection --show-secrets | grep -F '.psk:' | awk '{print $2}'`
	scan=`nmcli device wifi list --rescan no | grep -F "${ssid}"`
	if [ -z "$scan" ]
	then
		scan=`nmcli device wifi list --rescan yes | grep -F "${ssid}"`
	fi

	if [ -n "$scan" ]
	then
		sudo nmcli connection up "$selection"
	else
		exit 1
	fi
fi
