#!/bin/bash
activeSink=$(pactl get-default-sink)
activeSource=$(pactl get-default-source)

IFS='.' read -r sinkType sinkId sinkProfile <<< "$activeSink"
IFS='.' read -r sourceType sourceId sourceProfile <<< "$activeSource"

if [[ "$sinkType" == bluez_sink || "$sinkType" == bluez_output ]]; then
  sinkIdColon=$(echo $sinkId | sed 's/_/:/g')
  sinkDevice=$(echo "info $sinkIdColon" | bluetoothctl 2>/dev/null | ag -Q 'Alias: ' | sed 's/Alias: //g' | sed 's/^[ \t]*//')
fi

if [[ "$sourceType" == bluez_source || "$sourceType" == bluez_input ]]; then
  sourceIdColon=$(echo $sourceId | sed 's/_/:/g')
  sourceDevice=$(echo "info $sourceIdColon" | bluetoothctl 2>/dev/null | ag -Q 'Alias: ' | sed 's/Alias: //g' | sed 's/^[ \t]*//')
else
  sourceDevice=$sourceId
fi

target=/tmp/sound-info

sinkVolume=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+%' | head -1)
sinkMuted=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -oP '(yes|no)')

echo "sinkDevice    $sinkDevice" > $target
echo "sourceDevice  $sourceDevice" >> $target
echo "sinkType      $sinkType" >> $target
echo "sourceType    $sourceType" >> $target
echo "sinkId        $sinkId" >> $target
echo "sourceId      $sourceId" >> $target
echo "sinkProfile   $sinkProfile" >> $target
echo "sourceProfile $sourceProfile" >> $target
echo "sinkIdColon   $sinkIdColon" >> $target
echo "sourceIdColon $sourceIdColon" >> $target
echo "sinkVolume    $sinkVolume" >> $target
echo "sinkMuted     $sinkMuted" >> $target
