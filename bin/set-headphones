#!/bin/bash
if [ -n "$1" ]
then
	device_comma=$1
else
  name=`echo "devices Paired" | bluetoothctl 2>/dev/null | grep "^Device" | cut -d' ' -f3- | dmenu -i -l 100`
  device_comma=`echo "devices Paired" | bluetoothctl 2>/dev/null | grep "^Device" | grep "$name" | awk '{print $2}'`
fi

device=$(echo $device_comma | sed 's/:/_/g')

bluetoothctl connect $device_comma
sleep 3

card=$(pactl list short cards | awk -v c="bluez_card.$device" '$2 == c {print $2; exit}')
pactl set-card-profile "$card" headset-head-unit 2>/dev/null || pactl set-card-profile "$card" handsfree_head_unit
sleep 1

sink=$(pactl list short sinks | awk -v d="$device" '$2 ~ "^bluez_(sink|output)\\." d "\\." {print $2; exit}')
pactl set-default-sink "$sink"
sleep 1

source=$(pactl list short sources | awk -v d="$device" '$2 ~ "^bluez_(source|input)\\." d "\\." {print $2; exit}')
pactl set-default-source "$source"
