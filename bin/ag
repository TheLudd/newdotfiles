#!/usr/bin/env bash
# ag - ag-compatible front end for ripgrep, so scripts and the shell keep calling ag
# Usage: ag [ag options] PATTERN [PATH...]

args=(--smart-case)
ignore="${XDG_CONFIG_HOME:-$HOME/.config}/ag/ignore"
[ -f "$ignore" ] && args+=(--ignore-file "$ignore")

while (($#)); do
  case "$1" in
    -Q|--literal)     args+=(-F) ;;
    --path-to-ignore) args+=(--ignore-file "$2"); shift ;;
    -G)               args+=(-g "*$2*"); shift ;;
    --[a-z]*)
      if rg --type-list | grep -q "^${1#--}:"; then
        args+=(-t "${1#--}")
      else
        args+=("$1")
      fi
      ;;
    *)                args+=("$1") ;;
  esac
  shift
done

exec rg "${args[@]}"
