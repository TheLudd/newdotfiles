#!/bin/bash
# Rebuilds a bluetooth headset's audio output by switching its card off and back
# to the active profile. Reconnects streams left cut off after the headset was
# taken over by another device (e.g. a phone call).
# Usage: bt-audio-reset [bluez_card.XX_XX_XX_XX_XX_XX]
card=${1:-$(pactl list short cards | awk '/bluez_card/ {print $2; exit}')}
[ -n "$card" ] || exit 1

profile=$(pactl -f json list cards | jq -r --arg c "$card" '.[] | select(.name == $c) | .active_profile')
[ -n "$profile" ] && [ "$profile" != off ] || exit 1

"$HOME/bin/bt-set-profile" "$card" off "$profile"
