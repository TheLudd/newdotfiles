#!/bin/bash
# switch-kernel - switch this machine to a kernel chosen from a menu (lib/kernels)
# Usage: switch-kernel            pick, install and make it GRUB's default
#        switch-kernel --pending  print the kernels left to remove, fail when none
#        switch-kernel --cleanup  remove them
#
# The choice goes to /etc/newdotfiles/kernel (read by lib/kernel-package and
# lib/update-grub). The other kernels stay as GRUB fallbacks until the chosen
# one has booted: they are listed in a marker, and the first shell running the
# chosen kernel offers to remove them (config/zsh/pending-setup.zsh).
set -euo pipefail
dir="$(dirname "$(readlink -f "$0")")/.."
marker=/var/lib/newdotfiles/pending-kernel-cleanup

chosen() { cat /etc/newdotfiles/kernel 2>/dev/null || echo linux-lts; }
running_chosen() { grep -q "BOOT_IMAGE=/vmlinuz-$(chosen) " /proc/cmdline; }
# Installed kernels from lib/kernels other than the chosen one
others() { grep -vx "$(chosen)" "$dir/lib/kernels" | xargs pacman -Qq 2>/dev/null || true; }

pending() { [ -s "$marker" ] && running_chosen && cat "$marker"; }

cleanup() {
	local old
	mapfile -t old < <(pending) || true
	[ ${#old[@]} -gt 0 ] || { echo "Nothing to remove."; return; }
	# Their headers, installed for DKMS (lib/hardware-packages)
	mapfile -t -O ${#old[@]} old < <(printf '%s-headers\n' "${old[@]}" | xargs pacman -Qq 2>/dev/null) || true
	# The pacman hook regenerates grub.cfg
	sudo pacman -Rns --noconfirm "${old[@]}"
	sudo rm -f "$marker"
}

switch() {
	local new old answer
	new=$("$dir/lib/choose-kernel")
	echo "$new" | sudo install -Dm 644 /dev/stdin /etc/newdotfiles/kernel
	# With the hardware packages, which include the new kernel's headers for DKMS
	# shellcheck disable=SC2046
	sudo pacman -Syu --needed "$new" $("$dir/lib/hardware-packages")
	(cd "$dir" && system/60-grub)
	# The pacman hook runs only when a kernel is installed or removed
	sudo update-grub >/dev/null 2>&1

	mapfile -t old < <(others)
	if [ ${#old[@]} -eq 0 ]; then
		sudo rm -f "$marker"
		return
	fi
	printf '%s\n' "${old[@]}" | sudo install -Dm 644 /dev/stdin "$marker"
	if running_chosen; then
		read -rp "Running $new. Remove ${old[*]}? [y/N] " answer
		[[ "$answer" =~ ^[Yy] ]] && cleanup
		return 0
	fi
	echo "${old[*]} stays as the fallback in GRUB's advanced options until $new has booted."
	read -rp "Reboot into $new now? [Y/n] " answer
	[[ "${answer:-y}" =~ ^[Yy] ]] && systemctl reboot
	true
}

case "${1:-}" in
	"") switch ;;
	--pending) pending ;;
	--cleanup) cleanup ;;
	*) sed -n 's/^# \{0,1\}//; 2,5p' "$0"; exit 1 ;;
esac
