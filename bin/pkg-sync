#!/bin/bash
# pkg-sync - compare the installed packages with the package files and clean up drift
# Usage: pkg-sync                  list missing and extra packages, nothing when in sync
#        pkg-sync install          upgrade the system and install the missing ones
#        pkg-sync remove [pkg...]  remove the extra ones, or only the named ones
#
# Wanted (in setup/): packages, paru-packages, kept-packages, lib/kernel-package and
# lib/hardware-packages.
# Extra: installed explicitly (pacman -Qe) and not wanted. On remove, an extra
# package that another package still needs is marked as a dependency instead,
# and wanted packages installed as dependencies are marked explicit first so
# pacman does not remove them along with the package that pulled them in.
set -euo pipefail
dir="$(dirname "$(readlink -f "$0")")/../setup"

names() { grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$dir/$1"; }
repo_wanted() { names packages; "$dir/lib/kernel-package"; "$dir/lib/hardware-packages"; }
aur_wanted() { names paru-packages; }

# Names pacman reports as not installed; names provided by another package count as installed
missing_repo() { pacman -T $(repo_wanted) || true; }
missing_aur() { pacman -T $(aur_wanted) || true; }

# Real package names, so a provided name like python3 matches python
wanted() {
	pacman -Sp -dd --print-format %n $(repo_wanted)
	aur_wanted
	names kept-packages
}

extra() { comm -23 <(pacman -Qqe | sort) <(wanted | sort -u); }

show() {
	local title="$1"; shift
	[ $# -eq 0 ] && return 0
	echo "$title"
	printf '%s\n' "$@" | column -c "${COLUMNS:-100}" | sed 's/^/  /'
}

status() {
	local repo aur extras
	mapfile -t repo < <(missing_repo)
	mapfile -t aur < <(missing_aur)
	mapfile -t extras < <(extra)
	show "Missing (pkg-sync install):" "${repo[@]}" "${aur[@]}"
	show "Extra (pis / parus to keep, pkg-sync remove to drop):" "${extras[@]}"
	# Like diff: non-zero when there is drift
	[ $((${#repo[@]} + ${#aur[@]} + ${#extras[@]})) -eq 0 ]
}

install() {
	local repo aur
	mapfile -t repo < <(missing_repo)
	mapfile -t aur < <(missing_aur)
	[ ${#repo[@]} -gt 0 ] && sudo pacman -Syu --needed "${repo[@]}"
	[ ${#aur[@]} -gt 0 ] && paru -S --needed "${aur[@]}"
	true
}

# Wanted packages installed as a dependency would go with the package that pulled
# them in (pacman -Rns); marking them explicit keeps them
keep_wanted() {
	local deps
	mapfile -t deps < <(comm -12 <(pacman -Qqd | sort) <(wanted | sort -u))
	[ ${#deps[@]} -gt 0 ] && sudo pacman -D --asexplicit "${deps[@]}" >/dev/null
	true
}

remove() {
	local targets=("$@") needed=() unneeded=() p
	[ ${#targets[@]} -eq 0 ] && mapfile -t targets < <(extra)
	[ ${#targets[@]} -eq 0 ] && { echo "Nothing to remove."; return; }
	keep_wanted
	for p in "${targets[@]}"; do
		if [ "$(pacman -Qi "$p" | sed -n 's/^Required By *: //p')" = None ]; then
			unneeded+=("$p")
		else
			needed+=("$p")
		fi
	done
	if [ ${#needed[@]} -gt 0 ]; then
		show "Needed by other packages, marked as dependencies:" "${needed[@]}"
		sudo pacman -D --asdeps "${needed[@]}" >/dev/null
	fi
	[ ${#unneeded[@]} -gt 0 ] && sudo pacman -Rns "${unneeded[@]}"
	true
}

case "${1:-}" in
	"") status ;;
	install) install ;;
	remove) shift; remove "$@" ;;
	*) sed -n 's/^# \{0,1\}//; 2,5p' "$0"; exit 1 ;;
esac
