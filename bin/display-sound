#!/bin/bash
infoFile="${XDG_RUNTIME_DIR:-/run/user/$UID}/sound-info"
if [ -f "$infoFile" ];
then
  sinkDevice=$(cat $infoFile | grep 'sinkDevice' | awk '{print $2}')
  sourceDevice=$(cat $infoFile | grep 'sourceDevice' | awk '{print $2}')
  sourceType=$(cat $infoFile | grep 'sourceType' | awk '{print $2}')
  sinkType=$(cat $infoFile | grep 'sinkType' | awk '{print $2}')
  sinkVolume=$(cat $infoFile | grep 'sinkVolume' | awk '{print $2}')
  sinkMuted=$(cat $infoFile | grep 'sinkMuted' | awk '{print $2}')
  cardProfile=$(cat $infoFile | grep 'cardProfile' | awk '{print $2}')
  if [ "$sinkMuted" == "yes" ]; then
    speakerIcon="🔇"
    headphoneIcon="🔇"
  else
    speakerIcon="🔊"
    headphoneIcon="🎧"
  fi
  if [[ "$cardProfile" == headset-head-unit* && "$sinkDevice" == "$sourceDevice" ]]; then
    echo -e "$sinkDevice $sinkVolume $headphoneIcon"
  elif [[ "$sinkType" == bluez_sink || "$sinkType" == bluez_output ]]; then
    echo -e "$sinkDevice $sinkVolume $headphoneIcon🎤"
  else
    echo -e "$sinkVolume $speakerIcon 🎤"
  fi
fi
