#!/bin/bash
infoFile="${XDG_RUNTIME_DIR:-/run/user/$UID}/sound-info"
if [ -f "$infoFile" ];
then
  sinkDevice=$(cat $infoFile | ag 'sinkDevice' | awk '{print $2}')
  sourceDevice=$(cat $infoFile | ag 'sourceDevice' | awk '{print $2}')
  sourceType=$(cat $infoFile | ag 'sourceType' | awk '{print $2}')
  sinkType=$(cat $infoFile | ag 'sinkType' | awk '{print $2}')
  sinkVolume=$(cat $infoFile | ag 'sinkVolume' | awk '{print $2}')
  sinkMuted=$(cat $infoFile | ag 'sinkMuted' | awk '{print $2}')
  if [ "$sinkMuted" == "yes" ]; then
    speakerIcon="🔇"
    headphoneIcon="🔇"
  else
    speakerIcon="🔊"
    headphoneIcon="🎧"
  fi
  if [ "$sinkDevice" == "$sourceDevice" ]; then
    if [[ "$sourceType" == bluez_source || "$sourceType" == bluez_input ]]; then
      echo -e "$sinkDevice $sinkVolume $headphoneIcon"
    fi
  elif [[ "$sinkType" == bluez_sink || "$sinkType" == bluez_output ]]; then
    echo -e "$sinkDevice $sinkVolume $headphoneIcon🎤"
  else
    echo -e "$sinkVolume $speakerIcon 🎤"
  fi
fi
