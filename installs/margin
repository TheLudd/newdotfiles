#!/bin/bash
# Build and install margin, the markdown reader/editor for ~/code served at
# http://localhost:48217, then restart its user service if it is set up.
# Needs go, pnpm and the margin repo in ~/code/margin.
set -euo pipefail

src="$HOME/code/margin"
if [[ ! -d "$src" ]]; then
	echo "margin: $src not found, skipping"
	exit 0
fi

make -C "$src" install

if systemctl --user cat margin.service >/dev/null 2>&1; then
	systemctl --user daemon-reload
	systemctl --user restart margin.service
fi
