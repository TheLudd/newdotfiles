#!/bin/zsh
# Symlink Claude Code config into ~/.config/claude.
# Links each entry individually: that directory also holds sessions,
# credentials and history that must never be removed.
src="$(realpath "$(dirname "$0")/../claude")"
dest="$HOME/.config/claude"
mkdir -p "$dest"
for entry in "$src"/*; do
	target="$dest/$(basename "$entry")"
	echo ln -sfn "$entry" "$target"
	rm -rf "$target"
	ln -sfn "$entry" "$target"
done
