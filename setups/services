#!/bin/bash
repo=$(pwd)
cd /etc/systemd/system
sudo ln -s /usr/lib/systemd/system/NetworkManager.service
sudo ln -s /usr/lib/systemd/system/bluetooth.service

# Weekly download of pending upgrades so pup only has to install them
for unit in download-pacman-upgrades.service download-pacman-upgrades.timer; do
	sudo ln -sf "$repo/systemd/$unit" "/etc/systemd/system/$unit"
done
sudo systemctl daemon-reload
sudo systemctl enable --now download-pacman-upgrades.timer
