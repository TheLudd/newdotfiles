#!/bin/bash
# Install the packages in `packages` and the ones this machine's hardware needs
# (lib/hardware-packages), upgrading the system in the same run so nothing is
# installed against an outdated package database. Microcode needs no GRUB step:
# the mkinitcpio `microcode` hook packs it into the initramfs, which pacman
# rebuilds when firmware is installed.
set -euo pipefail
{ cat packages; lib/hardware-packages; } | sudo pacman -Syu --needed --noconfirm -
