[Unit]
Description=Keep a 5-hour Claude session window running
ConditionPathExists=%h/.local/bin/claude

[Service]
Environment=CLAUDE_CONFIG_DIR=%h/.config/claude
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin
WorkingDirectory=%h
ExecStart=%h/bin/claude-session-keeper
Restart=on-failure
RestartSec=60
