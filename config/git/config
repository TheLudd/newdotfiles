[user]
	email = ludwig@mediatool.com
	name = Ludwig Magnusson
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true          # n / N to jump between files
	side-by-side = true
	line-numbers = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default     # distinguishes moved code from added/removed
[alias]
	st = status -s
	co = commit -a
	a = add -A
	clf = clean -fd
	b = branch
	ch = checkout
	fix = commit -a --amend --no-edit
	pf = push --force-with-lease
	m = rebase master
	edit = reset HEAD~
	wl = worktree list
	dft = -c diff.external=difft diff
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[init]
	defaultBranch = master
[pull]
	rebase = true
[hub]
	protocol = ssh
[advice]
	skippedCherryPicks = false
  detachedHead = false
