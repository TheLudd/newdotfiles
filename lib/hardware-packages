#!/bin/bash
# hardware-packages [kernel] - print the packages this machine's hardware needs,
# one per line: microcode for the CPU, Vulkan and video drivers for each GPU
# vendor found, dkms and the kernel's headers for drivers built with DKMS
# (dkms/). The kernel defaults to lib/kernel-package; the installer passes its
# choice, since /etc/newdotfiles/kernel is written later.
# Read by scripts/archinstall/install-encrypted, system/10-packages,
# bin/switch-kernel and bin/pkg-sync.
dir="$(dirname "$(readlink -f "$0")")"
kernel=${1:-$("$dir/kernel-package")}

case "$(grep -m1 vendor_id /proc/cpuinfo)" in
	*AuthenticAMD*) echo amd-ucode ;;
	*GenuineIntel*) echo intel-ucode ;;
esac

# PCI vendor ids of the display devices
for vendor in $(cat /sys/class/drm/card*/device/vendor 2>/dev/null | sort -u); do
	case "$vendor" in
		0x8086) printf '%s\n' vulkan-intel intel-media-driver ;;
		0x1002) printf '%s\n' vulkan-radeon ;;
		0x10de) printf '%s\n' nvidia-open-lts nvidia-utils ;;
	esac
done

# MediaTek MT7902 Bluetooth (system/60-btusb-mt7902)
if "$dir/usb-present" 0489:e156; then
	printf '%s\n' dkms "$kernel-headers"
fi
