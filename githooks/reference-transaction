#!/bin/sh
# Refresh the repo status block in dwmblocks (signal 4, bin/repo-status)
# whenever a branch, HEAD or remote-tracking ref changes: commit, amend, rebase,
# reset, switching branches, merge, fetch and push. Used by this repo and the
# per-user dwm and dwmblocks clones (user/50-sources).
# The block runs git status, so it is signalled a second later, after the git
# command that fired this has finished.
[ "$1" = committed ] || exit 0
grep -q -e ' HEAD$' -e ' refs/' || exit 0
(sleep 1; pkill -RTMIN+4 dwmblocks) </dev/null >/dev/null 2>&1 &
exit 0
