# Regenerate grub.cfg when a kernel is installed or removed, so switching
# kernels (lib/kernel-package) needs no manual grub-mkconfig.
[Trigger]
Type = Path
Operation = Install
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Updating grub.cfg
When = PostTransaction
Exec = /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg
